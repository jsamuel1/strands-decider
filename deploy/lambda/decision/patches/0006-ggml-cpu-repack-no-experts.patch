+// GGML_CPU_REPACK_NO_EXPERTS=1 leaves a mixture of experts' expert weights (MUL_MAT_ID's) unrepacked, in the
+// buffer the model loader picks next, mapped from the model file, and repacks the rest. llama.cpp's
+// tensor overrides can't: one to the CPU buffer still considers the repack.
+static bool ggml_cpu_repack_no_experts(void) {
+    static const bool no_experts = getenv("GGML_CPU_REPACK_NO_EXPERTS") != nullptr;
+    return no_experts;
+}
