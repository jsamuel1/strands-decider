+
+// GGML_CPU_REPACK_FILE_DIR=<dir> puts the repacked weights in an unlinked file in <dir>, mapped
+// shared, instead of anonymous memory: the kernel can then write them back and drop them under
+// memory pressure, and read them in again, as it does the GGUF's own mapped weights. NULL, and the
+// caller allocates as usual, when the variable is unset or the file cannot be made.
+static ggml_backend_buffer_t ggml_backend_cpu_repack_file_buffer(size_t size) {
+    const char * dir = getenv("GGML_CPU_REPACK_FILE_DIR");
+    if (dir == nullptr || *dir == 0 || size == 0) {
+        return nullptr;
+    }
+    std::string path = std::string(dir) + "/ggml-repack-XXXXXX";
+    const int fd = mkstemp(&path[0]);
+    if (fd < 0) {
+        GGML_LOG_WARN("%s: cannot create a file in %s; repacking into memory\n", __func__, dir);
+        return nullptr;
+    }
+    unlink(path.c_str());
+    void * ptr = MAP_FAILED;
+    if (ftruncate(fd, (off_t) size) == 0) {
+        ptr = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    }
+    close(fd);
+    if (ptr == MAP_FAILED) {
+        GGML_LOG_WARN("%s: cannot map %zu bytes of a file in %s; repacking into memory\n", __func__, size, dir);
+        return nullptr;
+    }
+    ggml_backend_buffer_t buffer = ggml_backend_cpu_buffer_from_ptr(ptr, size);
+    if (buffer == nullptr) {
+        munmap(ptr, size);
+        return nullptr;
+    }
+    buffer->iface.free_buffer = ggml_backend_cpu_repack_file_buffer_free;
+    return buffer;
+}
+#endif
