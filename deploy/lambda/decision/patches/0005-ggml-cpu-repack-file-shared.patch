+static ggml_backend_buffer_t ggml_backend_cpu_repack_file_named(const std::string & dir, const char * key, size_t size) {
+    std::lock_guard<std::mutex> lock(repack_file_mutex);
+    const std::string name = dir + "/ggml-repack-" + key + "-" + std::to_string(repack_file_count++) + "-" + std::to_string(size);
+    int fd = open(name.c_str(), O_RDONLY | O_CLOEXEC);
